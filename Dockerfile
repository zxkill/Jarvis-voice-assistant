# syntax=docker/dockerfile:1
# Используем официальный образ Python со встроенными оптимизациями для работы на любых машинах.
FROM python:3.11-slim

# ─────────────────────────── СИСТЕМНЫЕ ЗАВИСИМОСТИ ───────────────────────────
# Устанавливаем необходимые пакеты: компилятор, PortAudio для работы с микрофоном,
# ffmpeg для конвертации аудио и утилиты, которые могут понадобиться при сборке.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    portaudio19-dev \
    libportaudio2 \
    ffmpeg \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Отключаем буферизацию вывода Python, чтобы логи сразу попадали в stdout.
ENV PYTHONUNBUFFERED=1

# Рабочая директория приложения.
WORKDIR /app

# Сначала копируем файл зависимостей для максимального кеширования слоёв.
COPY requirements.txt requirements.txt

# ─────────────────────────── PYTHON-ЗАВИСИМОСТИ ───────────────────────────
# Устанавливаем все Python-библиотеки, необходимые для работы Джарвиса.
RUN pip install --no-cache-dir -r requirements.txt

# Копируем остальной исходный код ассистента в контейнер.
COPY . .

# ─────────────────────────── ТОЧКА ВХОДА ───────────────────────────
# По умолчанию запускаем основной скрипт "start.py".
CMD ["python", "start.py"]
