# syntax=docker/dockerfile:1
# Используем официальный образ Python со встроенными оптимизациями для работы на любых машинах.
FROM python:3.11-slim

# ────────────────────── СИСТЕМНЫЕ ЗАВИСИМОСТИ ──────────────────────
# Устанавливаем необходимые пакеты: компилятор, PortAudio для работы с микрофоном,
# ffmpeg для конвертации аудио и утилиты, которые могут понадобиться при сборке.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    portaudio19-dev \
    libportaudio2 \
    ffmpeg \
    curl \
    git \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Отключаем буферизацию вывода Python, чтобы логи сразу попадали в stdout.
ENV PYTHONUNBUFFERED=1 \
    TZ=UTC

# Рабочая директория приложения.
WORKDIR /app

# Скопируем только файл зависимостей, чтобы образ не нуждался в пересборке при правках кода.
COPY requirements.txt requirements.txt

# ────────────────────── ПЫТОН-ЗАВИСИМОСТИ ──────────────────────
# Устанавливаем все Python-библиотеки, необходимые для работы Джарвиса.
RUN pip install --no-cache-dir -r requirements.txt

# Исходный код подмонтируется к контейнеру в момент запуска, поэтому копировать его внутрь не нужно.
# По сравнению с скопированным кодом, это решение позволяет мгновенно вносить правки без пересборки.

# ────────────────────── ТОЧКА ВХОДА ──────────────────────
# По умолчанию запускаем основной скрипт "start.py".
CMD ["python", "start.py"]
